# Firebase (Console -> Impostazioni progetto -> SDK config)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=

# Numero WhatsApp del locale (formato internazionale senza +)
VITE_LOCALE_PHONE=39XXXXXXXXXX
# Indirizzo del locale (mostrato nella schermata di ritiro).
VITE_LOCALE_ADDRESS=Via Aretusa, 6, 00155 Roma RM
# Opzionale: link "come arrivare". Se vuoto, viene costruito dall'indirizzo.
# Per puntare a una scheda luogo specifica di Google Maps, incolla qui il suo URL.
VITE_LOCALE_MAPS_URL=

# App Check — chiave del sito reCAPTCHA v3 (Console -> App Check).
# Se vuota, App Check resta spento (comodo in sviluppo).
VITE_APPCHECK_SITE_KEY=

# In sviluppo: "true" usa il debug token invece di reCAPTCHA, che su localhost
# non funziona. Il token va poi registrato in Console -> App Check.
# In produzione lasciare vuoto o assente.
VITE_APPCHECK_DEBUG=

# Admin usato dagli script seed / reset / pulisci-ordini.
# NON sono variabili VITE_: restano lato Node, non finiscono nel bundle.
SEED_EMAIL=
SEED_PASSWORD=

# ─── Stripe + prenotazione lato server (SOLO server, mai VITE_) ───────────────
# Chiavi test: Dashboard Stripe -> Sviluppatori -> Chiavi API
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret del webhook: lo stampa `stripe listen` in locale (whsec_...);
# in produzione è quello dell'endpoint creato in Dashboard -> Webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Service account Firebase come UNA riga JSON (Console -> Impostazioni progetto
# -> Account di servizio -> Genera nuova chiave privata). Incollare il JSON
# intero fra apici singoli; i \n nella private_key restano come stringa.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'

# Base pubblica dell'app, per i redirect di Checkout (senza slash finale).
# In locale: http://localhost:5173
APP_URL=https://cheebo.vercel.app
